# llm_proxy config — generated by llm_proxy-configurator

# Optional: listen address (default 127.0.0.1 — local only).
# Uncomment to expose both servers on the LAN: keep the Windows firewall
# exception for the proxy port and pair it with a token (below); other
# llm_proxy instances then connect here as bridges (remote = "<this ip>:9931").
# bind = '0.0.0.0'

# Security option: gate every request with a shared secret.
# token = "" means "generate a 256-bit secret on first start" — it is
# persisted back into this file and printed once; copy it into the bridge
# configs and in your OpenAI client set it as the API key. /health stays open.
# token = ''

active_profile = 'ninfer'

[proxy]
port = 9931
stats_port = 9935

# model_id: required — the id clients use. It forms the composite id
#   <profile>/<model_id> that /v1/models advertises and the harness always
#   addresses the model by it. If the backend reports a different id in its
#   own /v1/models, the proxy translates to it before relaying (clients
#   never notice). context_length / vision have no defaults: until the
#   backend is up, the proxy answers /v1/models on its own. Keep them in
#   sync with the backend --max-context / --vision flags.
[profiles.ninfer]
exe = 'C:\ninfer\ninfer-server.exe'
workdir = 'C:\ninfer'
model_id = 'qwen3.8-27b'
context_length = 32768
vision = true
idle_unload_secs = 1800  # optional: 0 = never
args = [
  'C:\ninfer\models\Qwen3.8-27B-IQ3_S.ninfer',
  '--max-context', '32768',
  '--host', '127.0.0.1',
  '--port', '8080',
  '--vision',
]

[profiles.llamacpp]
exe = 'C:\llama\llama-server.exe'
workdir = 'C:\llama'
model_id = 'gemma-4-26b'
context_length = 32768
vision = true
args = [
  '--model', 'C:\llama\models\gemma-4-26b-a4b-it-QAT-Q4_0.gguf',
  '--mmproj', 'C:\llama\models\mmproj-bf16.gguf',
  '--ctx-size', '32768',
  '--host', '127.0.0.1',
  '--port', '8080',
  '--metrics',            # required for the dashboard's backend metrics
]
